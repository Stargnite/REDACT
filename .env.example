# Copy this file to .env.local and fill it in. .env.local is gitignored.
#
# These values are inlined into the JavaScript bundle at build time, so they
# must be in .env.local BEFORE `npm run build`. Firebase Hosting serves static
# files and has no runtime environment, so there is nowhere else to set them.
#
# Firebase console > Project settings > Your apps > SDK setup and configuration.
# These are not secrets. A browser app cannot hold one.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase console > App Check > reCAPTCHA Enterprise. The site key is public.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Local development only. Create one with:
#   firebase appcheck:debugtokens:create --app <appId>
# Production builds ignore this value entirely - the code only reads it when
# NODE_ENV is not production - so it cannot be shipped even if it is set.
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=

# The cloud model, used only when a scan cannot stay on the device.
NEXT_PUBLIC_FIREBASE_CLOUD_MODEL=gemini-3.8-flash
